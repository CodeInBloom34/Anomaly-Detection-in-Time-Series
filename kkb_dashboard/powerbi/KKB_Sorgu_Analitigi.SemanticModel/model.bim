            "sourceColumn": "VKN",
            "summarizeBy": "none"
          },
          {
            "name": "SubeKod",
            "dataType": "string",
            "sourceColumn": "SubeKod",
            "summarizeBy": "none"
          },
          {
            "name": "KullaniciID",
            "dataType": "string",
            "sourceColumn": "KullaniciID",
            "summarizeBy": "none"
          },
          {
            "name": "RaporTipi",
            "dataType": "string",
            "sourceColumn": "RaporTipi",
            "summarizeBy": "none"
          },
          {
            "name": "SorguNedeni",
            "dataType": "string",
            "sourceColumn": "SorguNedeni",
            "summarizeBy": "none"
          },
          {
            "name": "SorguSonucu",
            "dataType": "string",
            "sourceColumn": "SorguSonucu",
            "summarizeBy": "none"
          },
          {
            "name": "SorguMaliyetTL",
            "dataType": "double",
            "sourceColumn": "SorguMaliyetTL",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "NakdiRisk",
            "dataType": "double",
            "sourceColumn": "NakdiRisk",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "OncekiSorguID",
            "dataType": "int64",
            "sourceColumn": "OncekiSorguID",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "OncekiSorguTarihi",
            "dataType": "dateTime",
            "sourceColumn": "OncekiSorguTarihi",
            "summarizeBy": "none",
            "formatString": "dd.mm.yyyy"
          },
          {
            "name": "OncekiBizimRisk",
            "dataType": "double",
            "sourceColumn": "OncekiBizimRisk",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "OncekiSektorToplamRisk",
            "dataType": "double",
            "sourceColumn": "OncekiSektorToplamRisk",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "OncekiGecikmeVar",
            "dataType": "int64",
            "sourceColumn": "OncekiGecikmeVar",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "OncekiTakipVar",
            "dataType": "int64",
            "sourceColumn": "OncekiTakipVar",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "OncekiKKBNot",
            "dataType": "int64",
            "sourceColumn": "OncekiKKBNot",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "OncekiBankaSayisi",
            "dataType": "int64",
            "sourceColumn": "OncekiBankaSayisi",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "OncekiGayrinakdiRisk",
            "dataType": "double",
            "sourceColumn": "OncekiGayrinakdiRisk",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "SorgularArasiGun",
            "dataType": "int64",
            "sourceColumn": "SorgularArasiGun",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "SonrakiSektorToplamRisk",
            "dataType": "double",
            "sourceColumn": "SonrakiSektorToplamRisk",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "SonrakiGecikmeVar",
            "dataType": "int64",
            "sourceColumn": "SonrakiGecikmeVar",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "SonSorguMu",
            "dataType": "int64",
            "sourceColumn": "SonSorguMu",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "BizimPay",
            "dataType": "double",
            "sourceColumn": "BizimPay",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "OncekiBizimPay",
            "dataType": "double",
            "sourceColumn": "OncekiBizimPay",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "BizimDoluluk",
            "dataType": "double",
            "sourceColumn": "BizimDoluluk",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "DigerBankaDoluluk",
            "dataType": "double",
            "sourceColumn": "DigerBankaDoluluk",
            "summarizeBy": "none",
            "formatString": "0.0%"
          },
          {
            "name": "NotBandi",
            "dataType": "string",
            "sourceColumn": "NotBandi",
            "summarizeBy": "none"
          },
          {
            "name": "OncekiNotBandi",
            "dataType": "string",
            "sourceColumn": "OncekiNotBandi",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Tekrar Araligi",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    ISBLANK ( Fact_Sorgu[SorgularArasiGun] ), \"0) Ilk sorgu\",",
              "    Fact_Sorgu[SorgularArasiGun] <= 7, \"1) 0-7 gun\",",
              "    Fact_Sorgu[SorgularArasiGun] <= 30, \"2) 8-30 gun\",",
              "    Fact_Sorgu[SorgularArasiGun] <= 90, \"3) 31-90 gun\",",
              "    Fact_Sorgu[SorgularArasiGun] <= 180, \"4) 91-180 gun\",",
              "    \"5) 180+ gun\"",
              ")"
            ],
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Banka Degisimi",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "VAR d = Fact_Sorgu[BankaSayisi] - Fact_Sorgu[OncekiBankaSayisi]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( Fact_Sorgu[OncekiBankaSayisi] ), \"Ilk sorgu\",",
              "        d > 0, \"Artti\",",
              "        d < 0, \"Azaldi\",",
              "        \"Ayni\"",
              "    )"
            ],
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Not Degisimi",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "VAR d = Fact_Sorgu[KKBNot] - Fact_Sorgu[OncekiKKBNot]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( Fact_Sorgu[OncekiKKBNot] ), \"Ilk sorgu\",",
              "        d >= 50, \"Yukseldi\",",
              "        d <= -50, \"Dustu\",",
              "        \"Ayni\"",
              "    )"
            ],
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Cuzdan Bolgesi",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "VAR dPay = Fact_Sorgu[BizimPay] - Fact_Sorgu[OncekiBizimPay]",
              "VAR dRisk = Fact_Sorgu[SektorToplamRisk] - Fact_Sorgu[OncekiSektorToplamRisk]",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        ISBLANK ( Fact_Sorgu[OncekiBizimPay] ), \"Tek sorgu\",",
              "        dRisk >= 0 && dPay < 0, \"Rakip buyutuyor\",",
              "        dRisk >= 0, \"Birlikte buyuyoruz\",",
              "        dPay < 0, \"Sessiz cikis\",",
              "        \"Ana bankaya donusuyoruz\"",
              "    )"
            ],
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Aksiyon Etiketi",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "VAR ilk = ISBLANK ( Fact_Sorgu[OncekiSorguID] )",
              "VAR dPay = Fact_Sorgu[BizimPay] - Fact_Sorgu[OncekiBizimPay]",
              "VAR dRisk = Fact_Sorgu[SektorToplamRisk] - Fact_Sorgu[OncekiSektorToplamRisk]",
              "VAR dGn =",
              "    DIVIDE ( Fact_Sorgu[GayrinakdiRisk], Fact_Sorgu[SektorToplamRisk] )",
              "        - DIVIDE ( Fact_Sorgu[OncekiGayrinakdiRisk], Fact_Sorgu[OncekiSektorToplamRisk] )",
              "VAR dNot = Fact_Sorgu[KKBNot] - Fact_Sorgu[OncekiKKBNot]",
              "VAR dBanka = Fact_Sorgu[BankaSayisi] - Fact_Sorgu[OncekiBankaSayisi]",
              "VAR skor =",
              "    LOOKUPVALUE ( Fact_AnomaliSkor[Skor], Fact_AnomaliSkor[SorguID], Fact_Sorgu[SorguID] )",
              "VAR doluluk = DIVIDE ( Fact_Sorgu[SektorToplamRisk], Fact_Sorgu[SektorToplamLimit] )",
              "RETURN",
              "    SWITCH (",
              "        TRUE (),",
              "        Fact_Sorgu[GecikmeVar] = 1, \"Erken uyari\",",
              "        Fact_Sorgu[TakipVar] = 1, \"Erken uyari\",",
              "        NOT ilk && skor >= 70 && dNot < 0, \"Erken uyari\",",
              "        NOT ilk && dBanka >= 2 && dNot < 0, \"Kredi acligi\",",
              "        NOT ilk && dRisk > 0 && dPay <= -0.05 && dNot >= 0, \"Pay geri kazan\",",
              "        doluluk > 0.85 && Fact_Sorgu[BizimDoluluk] < 0.6",
              "            && Fact_Sorgu[NotBandi] IN { \"A\", \"B\" }, \"Limit sikisikligi\",",
              "        NOT ilk && dGn >= 0.10 && Fact_Sorgu[GecikmeVar] = 0, \"Proje buyumesi\",",
              "        NOT ilk && Fact_Sorgu[SorgularArasiGun] <= 7, \"Gereksiz sorgu\",",
              "        \"Izle\"",
              "    )"
            ],
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Potansiyel TL",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH (",
              "    Fact_Sorgu[Aksiyon Etiketi],",
              "    \"Pay geri kazan\",",
              "        MAX ( 0, ( Fact_Sorgu[OncekiBizimPay] - Fact_Sorgu[BizimPay] ) * Fact_Sorgu[SektorToplamRisk] ),",
              "    \"Limit sikisikligi\",",
              "        MAX ( 0, Fact_Sorgu[BizimLimit] - Fact_Sorgu[BizimRisk] ),",
              "    \"Proje buyumesi\",",
              "        MAX ( 0, ( Fact_Sorgu[GayrinakdiRisk] - Fact_Sorgu[OncekiGayrinakdiRisk] ) * Fact_Sorgu[OncekiBizimPay] ),",
              "    0",
              ")"
            ],
            "summarizeBy": "none",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Fact_Sorgu",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Kaynak = Csv.Document(File.Contents(VeriKlasoru & \"\\Fact_Sorgu.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Basliklar = Table.PromoteHeaders(Kaynak, [PromoteAllScalars = true]),",
                "    Bosluklar = Table.TransformColumns(Basliklar, {}, each if _ = \"\" then null else _),",
                "    Tipler = Table.TransformColumnTypes(Bosluklar, {{\"SorguTarihi\", type date}, {\"SektorToplamLimit\", type number}, {\"SektorToplamRisk\", type number}, {\"GayrinakdiRisk\", type number}, {\"BankaSayisi\", Int64.Type}, {\"GecikmeVar\", Int64.Type}, {\"TakipVar\", Int64.Type}, {\"KKBNot\", Int64.Type}, {\"CekKarsiliksizAdet\", Int64.Type}, {\"BizimLimit\", type number}, {\"BizimRisk\", type number}, {\"SorguID\", Int64.Type}, {\"VKN\", type text}, {\"SubeKod\", type text}, {\"KullaniciID\", type text}, {\"RaporTipi\", type text}, {\"SorguNedeni\", type text}, {\"SorguSonucu\", type text}, {\"SorguMaliyetTL\", type number}, {\"NakdiRisk\", type number}, {\"OncekiSorguID\", Int64.Type}, {\"OncekiSorguTarihi\", type date}, {\"OncekiBizimRisk\", type number}, {\"OncekiSektorToplamRisk\", type number}, {\"OncekiGecikmeVar\", Int64.Type}, {\"OncekiTakipVar\", Int64.Type}, {\"OncekiKKBNot\", Int64.Type}, {\"OncekiBankaSayisi\", Int64.Type}, {\"OncekiGayrinakdiRisk\", type number}, {\"SorgularArasiGun\", Int64.Type}, {\"SonrakiSektorToplamRisk\", type number}, {\"SonrakiGecikmeVar\", Int64.Type}, {\"SonSorguMu\", Int64.Type}, {\"BizimPay\", type number}, {\"OncekiBizimPay\", type number}, {\"BizimDoluluk\", type number}, {\"DigerBankaDoluluk\", type number}, {\"NotBandi\", type text}, {\"OncekiNotBandi\", type text}}, \"en-US\")",
                "in",
                "    Tipler"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Sorgu Adedi",
            "expression": [
              "COUNTROWS ( Fact_Sorgu )"
            ],
            "displayFolder": "1 Ozet",
            "formatString": "#,0"
          },
          {
            "name": "Tekil Musteri",
            "expression": [
              "DISTINCTCOUNT ( Fact_Sorgu[VKN] )"
            ],
            "displayFolder": "1 Ozet",
            "formatString": "#,0"
          },
          {
            "name": "Musteri Basina Sorgu",
            "expression": [
              "DIVIDE ( [Sorgu Adedi], [Tekil Musteri] )"
            ],
            "displayFolder": "1 Ozet",
            "formatString": "0.00"
          },
          {
            "name": "Basvuru Sorgusu",
            "expression": [
              "CALCULATE ( [Sorgu Adedi], KEEPFILTERS ( Fact_Sorgu[SorguNedeni] IN { \"Yeni Basvuru\", \"Limit Yenileme\" } ) )"
            ],
            "displayFolder": "1 Ozet",
            "formatString": "#,0"
          },
          {
            "name": "Sorgu Donusum %",
            "expression": [
              "DIVIDE ( CALCULATE ( [Basvuru Sorgusu], KEEPFILTERS ( Fact_Sorgu[SorguSonucu] = \"Kullandirim\" ) ), [Basvuru Sorgusu] )"
            ],
            "displayFolder": "1 Ozet",
            "formatString": "0.0%"
          },
          {
            "name": "Olu Sorgu Orani %",
            "expression": [
              "DIVIDE ( CALCULATE ( [Basvuru Sorgusu], KEEPFILTERS ( Fact_Sorgu[SorguSonucu] = \"Aksiyon Yok\" ) ), [Basvuru Sorgusu] )"
            ],
            "displayFolder": "1 Ozet",
            "formatString": "0.0%"
          },
          {
            "name": "Toplam Sorgu Maliyeti TL",
            "expression": [
              "SUM ( Fact_Sorgu[SorguMaliyetTL] )"
            ],
            "displayFolder": "1 Ozet",
            "formatString": "#,0"
          },
          {
            "name": "Olu Sorgu Maliyeti TL",
            "expression": [
              "CALCULATE ( [Toplam Sorgu Maliyeti TL], KEEPFILTERS ( Fact_Sorgu[SorguSonucu] = \"Aksiyon Yok\" ) )"
            ],
            "displayFolder": "1 Ozet",
            "formatString": "#,0"
          },
          {
            "name": "Cuzdan Payi",
            "expression": [
              "DIVIDE ( SUM ( Fact_Sorgu[BizimRisk] ), SUM ( Fact_Sorgu[SektorToplamRisk] ) )"
            ],
            "displayFolder": "1 Ozet",
            "formatString": "0.0%"
          },
          {
            "name": "Payi Eriyen Musteri",
            "expression": [
              "CALCULATE (",
              "    [Tekil Musteri],",
              "    FILTER (",
              "        Fact_Sorgu,",
              "        NOT ISBLANK ( Fact_Sorgu[OncekiBizimPay] )",
              "            && Fact_Sorgu[BizimPay] - Fact_Sorgu[OncekiBizimPay] < -0.05",
              "    )",
              ")"
            ],
            "displayFolder": "1 Ozet",
            "formatString": "#,0"
          },
          {
            "name": "Yeni Gecikme Sinyali",
            "expression": [
              "CALCULATE (",
              "    [Tekil Musteri],",
              "    FILTER (",
              "        Fact_Sorgu,",
              "        Fact_Sorgu[GecikmeVar] = 1",
              "            && NOT ISBLANK ( Fact_Sorgu[OncekiGecikmeVar] )",
              "            && Fact_Sorgu[OncekiGecikmeVar] = 0",
              "    )",
              ")"
            ],
            "displayFolder": "1 Ozet",
            "formatString": "#,0"
          },
          {
            "name": "Yeni Takip Gecisi",
            "expression": [
              "CALCULATE (",
              "    [Tekil Musteri],",
              "    FILTER (",
              "        Fact_Sorgu,",
              "        Fact_Sorgu[TakipVar] = 1",
              "            && NOT ISBLANK ( Fact_Sorgu[OncekiTakipVar] )",
              "            && Fact_Sorgu[OncekiTakipVar] = 0",
              "    )",
              ")"
            ],
            "displayFolder": "1 Ozet",
            "formatString": "#,0"
          },
          {
            "name": "Ozet Cumle",
            "expression": [
              "\"Bu donemde \" & FORMAT ( [Tekil Musteri], \"#,0\" ) & \" musteriye \" & FORMAT ( [Sorgu Adedi], \"#,0\" )",
              "    & \" sorgu attik. \" & FORMAT ( [Payi Eriyen Musteri], \"#,0\" ) & \" musteride payimiz eridi, \"",
              "    & FORMAT ( [Yeni Gecikme Sinyali], \"#,0\" ) & \" musteride yeni gecikme sinyali var. \"",
              "    & \"Aksiyonsuz sorgularin maliyeti \" & FORMAT ( [Olu Sorgu Maliyeti TL], \"#,0\" ) & \" TL; \"",
              "    & FORMAT ( [Kor Nokta Musteri], \"#,0\" ) & \" riskli musteriye hic bakmadik.\""
            ],
            "displayFolder": "1 Ozet"
          },
          {
            "name": "Huni Deger",
            "expression": [
              "SWITCH (",
              "    SELECTEDVALUE ( 'Huni Asama'[Sira] ),",
              "    1, [Basvuru Sorgusu],",
              "    2, CALCULATE ( [Basvuru Sorgusu], KEEPFILTERS ( Fact_Sorgu[SorguSonucu] IN { \"Teklif\", \"Ret\", \"Kullandirim\" } ) ),",
              "    3, CALCULATE ( [Basvuru Sorgusu], KEEPFILTERS ( Fact_Sorgu[SorguSonucu] = \"Kullandirim\" ) )",
              ")"
            ],
            "displayFolder": "2 Davranis",
            "formatString": "#,0"
          },
          {
            "name": "Mukerrer Sorgu (7 gun)",
            "expression": [
              "CALCULATE (",
              "    [Sorgu Adedi],",
              "    FILTER (",
              "        Fact_Sorgu,",
              "        NOT ISBLANK ( Fact_Sorgu[SorgularArasiGun] ) && Fact_Sorgu[SorgularArasiGun] <= 7",
              "    )",
              ")"
            ],
            "displayFolder": "2 Davranis",
            "formatString": "#,0"
          },
          {
            "name": "Ortalama Sorgudan Kullandirima Gun",
            "expression": [
              "AVERAGEX (",
              "    FILTER ( Fact_KrediSonuc, NOT ISBLANK ( Fact_KrediSonuc[KullandirimTarihi] ) ),",
              "    DATEDIFF (",
              "        LOOKUPVALUE ( Fact_Sorgu[SorguTarihi], Fact_Sorgu[SorguID], Fact_KrediSonuc[SorguID] ),",
              "        Fact_KrediSonuc[KullandirimTarihi],",
              "        DAY",
              "    )",
              ")"
            ],
            "displayFolder": "2 Davranis",
            "formatString": "0.0"
          },
          {
            "name": "Kor Nokta Musteri",
            "expression": [
              "VAR riskli =",
              "    CALCULATETABLE ( VALUES ( Fact_KrediSonuc[VKN] ), KEEPFILTERS ( Fact_KrediSonuc[BizimRisk] > 0 ) )",
              "VAR sorgulanan = VALUES ( Fact_Sorgu[VKN] )",
              "RETURN",
              "    COUNTROWS ( EXCEPT ( riskli, sorgulanan ) ) + 0"
            ],
            "displayFolder": "2 Davranis",
            "formatString": "#,0"
          },
          {
            "name": "Kor Nokta Risk TL",
            "expression": [
              "VAR sonAy = MAX ( Fact_KrediSonuc[Tarih] )",
              "VAR sorgulanan = VALUES ( Fact_Sorgu[VKN] )",
              "RETURN",
              "    SUMX (",
              "        FILTER (",
              "            Fact_KrediSonuc,",
              "            Fact_KrediSonuc[Tarih] = sonAy",
              "                && NOT ( Fact_KrediSonuc[VKN] IN sorgulanan )",
              "        ),",
              "        Fact_KrediSonuc[BizimRisk]",
              "    )"
            ],
            "displayFolder": "2 Davranis",
            "formatString": "#,0"
          },
          {
            "name": "Sektor Risk TL",
            "expression": [
              "SUM ( Fact_Sorgu[SektorToplamRisk] )"
            ],
            "displayFolder": "3 Risk Gocu",
            "formatString": "#,0"
          },
          {
            "name": "Bizim Risk Artisi",
            "expression": [
              "SUMX (",
              "    FILTER ( Fact_Sorgu, NOT ISBLANK ( Fact_Sorgu[OncekiBizimRisk] ) ),",
              "    Fact_Sorgu[BizimRisk] - Fact_Sorgu[OncekiBizimRisk]",
              ")"
            ],
            "displayFolder": "3 Risk Gocu",
            "formatString": "#,0"
          },
          {
            "name": "Sektor Risk Artisi",
            "expression": [
              "SUMX (",
              "    FILTER ( Fact_Sorgu, NOT ISBLANK ( Fact_Sorgu[OncekiSektorToplamRisk] ) ),",
              "    Fact_Sorgu[SektorToplamRisk] - Fact_Sorgu[OncekiSektorToplamRisk]",
              ")"
            ],
            "displayFolder": "3 Risk Gocu",
            "formatString": "#,0"
          },
          {
            "name": "Rakip Risk Artisi",
            "expression": [
              "[Sektor Risk Artisi] - [Bizim Risk Artisi]"
            ],
            "displayFolder": "3 Risk Gocu",
            "formatString": "#,0"
          },
          {
            "name": "Kopru Deger",
            "expression": [
              "SWITCH (",
              "    SELECTEDVALUE ( 'Risk Kopru'[Sira] ),",
              "    1, [Bizim Risk Artisi],",
              "    2, [Rakip Risk Artisi]",
              ")"
            ],
            "displayFolder": "3 Risk Gocu",
            "formatString": "#,0"
          },
          {
            "name": "Sektor Risk Buyumesi %",
            "expression": [
              "DIVIDE (",
              "    [Sektor Risk Artisi],",
              "    SUMX (",
              "        FILTER ( Fact_Sorgu, NOT ISBLANK ( Fact_Sorgu[OncekiSektorToplamRisk] ) ),",
              "        Fact_Sorgu[OncekiSektorToplamRisk]",
              "    )",
              ")"
            ],
            "displayFolder": "3 Risk Gocu",
            "formatString": "0.0%"
          },
          {
            "name": "Buyumede Bizim Pay",
            "expression": [
              "DIVIDE ( [Bizim Risk Artisi], [Sektor Risk Artisi] )"
            ],
            "displayFolder": "3 Risk Gocu",
            "formatString": "0.0%"
          },
          {
            "name": "Not Degisimi Ort",
            "expression": [
              "AVERAGEX (",
              "    FILTER ( Fact_Sorgu, NOT ISBLANK ( Fact_Sorgu[OncekiKKBNot] ) ),",
              "    Fact_Sorgu[KKBNot] - Fact_Sorgu[OncekiKKBNot]",
              ")"
            ],
            "displayFolder": "3 Risk Gocu",
            "formatString": "#,0"
          },
          {
            "name": "Ortalama Limit Doluluk",
            "expression": [
              "DIVIDE ( SUM ( Fact_Sorgu[SektorToplamRisk] ), SUM ( Fact_Sorgu[SektorToplamLimit] ) )"
            ],
            "displayFolder": "3 Risk Gocu",
            "formatString": "0.0%"
          },
          {
            "name": "Banka Sayisi Artan Musteri",
            "expression": [
              "CALCULATE (",
              "    [Tekil Musteri],",
              "    FILTER ( Fact_Sorgu, Fact_Sorgu[BankaSayisi] > Fact_Sorgu[OncekiBankaSayisi]",
              "        && NOT ISBLANK ( Fact_Sorgu[OncekiBankaSayisi] ) )",
              ")"
            ],
            "displayFolder": "3 Risk Gocu",
            "formatString": "#,0"
          },
          {
            "name": "Pay Degisimi",
            "expression": [
              "AVERAGEX (",
              "    FILTER ( Fact_Sorgu, NOT ISBLANK ( Fact_Sorgu[OncekiBizimPay] ) ),",
              "    Fact_Sorgu[BizimPay] - Fact_Sorgu[OncekiBizimPay]",
              ")"
            ],
            "displayFolder": "4 Rakip",
            "formatString": "0.0%"
          },
          {
            "name": "Yedek Banka Endeksi",
            "expression": [
              "AVERAGEX ( Fact_Sorgu, Fact_Sorgu[DigerBankaDoluluk] - Fact_Sorgu[BizimDoluluk] )"
            ],
            "displayFolder": "4 Rakip",
            "formatString": "0.00"
          },
          {
            "name": "Rakip Ortalama Limit",
            "expression": [
              "AVERAGEX (",
              "    FILTER ( Fact_Sorgu, Fact_Sorgu[BankaSayisi] > 1 ),",
              "    DIVIDE ( Fact_Sorgu[SektorToplamLimit] - Fact_Sorgu[BizimLimit], Fact_Sorgu[BankaSayisi] - 1 )",
              ")"
            ],
            "displayFolder": "4 Rakip",
            "formatString": "#,0"
          },
          {
            "name": "Bizim Limit / Rakip Limit",
            "expression": [
              "DIVIDE ( AVERAGE ( Fact_Sorgu[BizimLimit] ), [Rakip Ortalama Limit] )"
            ],
            "displayFolder": "4 Rakip",
            "formatString": "0.00"
          },
          {
            "name": "Ana Banka Orani %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE (",
              "        [Tekil Musteri],",
              "        FILTER ( Fact_Sorgu, Fact_Sorgu[BizimPay] >= 1.5 / Fact_Sorgu[BankaSayisi] )",
              "    ),",
              "    [Tekil Musteri]",
              ")"
            ],
            "displayFolder": "4 Rakip",
            "formatString": "0.0%"
          },
          {
            "name": "Ret Sonrasi Musteri",
            "expression": [
              "COUNTROWS (",
              "    FILTER (",
              "        Fact_Sorgu,",
              "        Fact_Sorgu[SorguSonucu] IN { \"Ret\", \"Teklif\" }",
              "            && NOT ISBLANK ( Fact_Sorgu[SonrakiSektorToplamRisk] )",
              "    )",
              ")"
            ],
            "displayFolder": "4 Rakip",
            "formatString": "#,0"
          },
          {
            "name": "Ret Sonrasi Buyuyen %",
            "expression": [
              "VAR t =",
              "    FILTER (",
              "        Fact_Sorgu,",
              "        Fact_Sorgu[SorguSonucu] IN { \"Ret\", \"Teklif\" }",
              "            && NOT ISBLANK ( Fact_Sorgu[SonrakiSektorToplamRisk] )",
              "    )",
              "RETURN",
              "    DIVIDE (",
              "        COUNTROWS ( FILTER ( t, Fact_Sorgu[SonrakiSektorToplamRisk] > Fact_Sorgu[SektorToplamRisk] * 1.1 ) ),",
              "        COUNTROWS ( t )",
              "    )"
            ],
            "displayFolder": "4 Rakip",
            "formatString": "0.0%"
          },
          {
            "name": "Ret Sonrasi Gecikme %",
            "expression": [
              "VAR t =",
              "    FILTER (",
              "        Fact_Sorgu,",
              "        Fact_Sorgu[SorguSonucu] IN { \"Ret\", \"Teklif\" }",
              "            && NOT ISBLANK ( Fact_Sorgu[SonrakiGecikmeVar] )",
              "            && Fact_Sorgu[GecikmeVar] = 0",
              "    )",
              "RETURN",
              "    DIVIDE ( COUNTROWS ( FILTER ( t, Fact_Sorgu[SonrakiGecikmeVar] = 1 ) ), COUNTROWS ( t ) )"
            ],
            "displayFolder": "4 Rakip",
            "formatString": "0.0%"
          },
          {
            "name": "Ortalama KKB Not",
            "expression": [
              "AVERAGE ( Fact_Sorgu[KKBNot] )"
            ],
            "displayFolder": "5 Erken Uyari",
            "formatString": "#,0"
          },
          {
            "name": "Aksiyon Musteri",
            "expression": [
              "CALCULATE ( [Tekil Musteri], KEEPFILTERS ( Fact_Sorgu[SonSorguMu] = 1 ) )"
            ],
            "displayFolder": "6 Aksiyon",
            "formatString": "#,0"
          },
          {
            "name": "Potansiyel TL (son)",
            "expression": [
              "CALCULATE ( SUM ( Fact_Sorgu[Potansiyel TL] ), KEEPFILTERS ( Fact_Sorgu[SonSorguMu] = 1 ) )"
            ],
            "displayFolder": "6 Aksiyon",
            "formatString": "#,0"
          },
          {
            "name": "Bizim Risk (son)",
            "expression": [
              "CALCULATE ( SUM ( Fact_Sorgu[BizimRisk] ), KEEPFILTERS ( Fact_Sorgu[SonSorguMu] = 1 ) )"
            ],
            "displayFolder": "6 Aksiyon",
            "formatString": "#,0"
          },
          {
            "name": "Son Sorgu Tarihi",
            "expression": [
              "CALCULATE ( MAX ( Fact_Sorgu[SorguTarihi] ), KEEPFILTERS ( Fact_Sorgu[SonSorguMu] = 1 ) )"
            ],
            "displayFolder": "6 Aksiyon",
            "formatString": "dd.mm.yyyy"
          },
          {
            "name": "Anomali Skoru (aksiyon)",
            "expression": [
              "IF ( NOT ISBLANK ( [Son Sorgu Tarihi] ), [Anomali Skoru (son sorgu)] )"
            ],
            "displayFolder": "6 Aksiyon",
            "formatString": "0.0"
          }
        ]
      },
      {
        "name": "Fact_RiskDetay",
        "columns": [
          {
            "name": "SorguID",
            "dataType": "int64",
            "sourceColumn": "SorguID",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "KrediTuru",
            "dataType": "string",
            "sourceColumn": "KrediTuru",
            "summarizeBy": "none"
          },
          {
            "name": "Limit",
            "dataType": "double",
            "sourceColumn": "Limit",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "Risk",
            "dataType": "double",
            "sourceColumn": "Risk",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "GecikmeGun",
            "dataType": "int64",
            "sourceColumn": "GecikmeGun",
            "summarizeBy": "none",
            "formatString": "0"
          }
        ],
        "partitions": [
          {
            "name": "Fact_RiskDetay",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Kaynak = Csv.Document(File.Contents(VeriKlasoru & \"\\Fact_RiskDetay.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Basliklar = Table.PromoteHeaders(Kaynak, [PromoteAllScalars = true]),",
                "    Bosluklar = Table.TransformColumns(Basliklar, {}, each if _ = \"\" then null else _),",
                "    Tipler = Table.TransformColumnTypes(Bosluklar, {{\"SorguID\", Int64.Type}, {\"KrediTuru\", type text}, {\"Limit\", type number}, {\"Risk\", type number}, {\"GecikmeGun\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipler"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Risk Detay TL",
            "expression": [
              "SUM ( Fact_RiskDetay[Risk] )"
            ],
            "displayFolder": "3 Risk Gocu",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Fact_KrediSonuc",
        "columns": [
          {
            "name": "VKN",
            "dataType": "string",
            "sourceColumn": "VKN",
            "summarizeBy": "none"
          },
          {
            "name": "Tarih",
            "dataType": "dateTime",
            "sourceColumn": "Tarih",
            "summarizeBy": "none",
            "formatString": "dd.mm.yyyy"
          },
          {
            "name": "BizimRisk",
            "dataType": "double",
            "sourceColumn": "BizimRisk",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "BizimLimit",
            "dataType": "double",
            "sourceColumn": "BizimLimit",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "IcRating",
            "dataType": "int64",
            "sourceColumn": "IcRating",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "SorguID",
            "dataType": "int64",
            "sourceColumn": "SorguID",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "TeklifTarihi",
            "dataType": "dateTime",
            "sourceColumn": "TeklifTarihi",
            "summarizeBy": "none",
            "formatString": "dd.mm.yyyy"
          },
          {
            "name": "OnayTarihi",
            "dataType": "dateTime",
            "sourceColumn": "OnayTarihi",
            "summarizeBy": "none",
            "formatString": "dd.mm.yyyy"
          },
          {
