        "partitions": [
          {
            "name": "Fact_AnomaliSkor",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Kaynak = Csv.Document(File.Contents(VeriKlasoru & \"\\Fact_AnomaliSkor.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Basliklar = Table.PromoteHeaders(Kaynak, [PromoteAllScalars = true]),",
                "    Bosluklar = Table.TransformColumns(Basliklar, {}, each if _ = \"\" then null else _),",
                "    Tipler = Table.TransformColumnTypes(Bosluklar, {{\"SorguID\", Int64.Type}, {\"VKN\", type text}, {\"SorguTarihi\", type date}, {\"Skor\", type number}, {\"Neden\", type text}, {\"BireyselSapma\", type number}, {\"AkranSapmasi\", type number}, {\"SonSorguMu\", Int64.Type}, {\"GecikmeVar\", Int64.Type}, {\"SonrakiGecikmeVar\", Int64.Type}, {\"RiskBuyume30g\", type number}, {\"DolulukDelta\", type number}, {\"BankaSayisiDelta\", Int64.Type}, {\"NotDelta\", Int64.Type}, {\"GayrinakdiPayDelta\", type number}, {\"RotatifPayDelta\", type number}, {\"BizimPayDelta\", type number}}, \"en-US\")",
                "in",
                "    Tipler"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Anomali Skoru (son sorgu)",
            "expression": [
              "CALCULATE ( MAX ( Fact_AnomaliSkor[Skor] ), KEEPFILTERS ( Fact_AnomaliSkor[SonSorguMu] = 1 ) )"
            ],
            "displayFolder": "5 Erken Uyari",
            "formatString": "0.0"
          },
          {
            "name": "Anomali Nedeni (son)",
            "expression": [
              "VAR s = [Anomali Skoru (son sorgu)]",
              "RETURN",
              "    CALCULATE (",
              "        MAX ( Fact_AnomaliSkor[Neden] ),",
              "        KEEPFILTERS ( Fact_AnomaliSkor[SonSorguMu] = 1 ),",
              "        KEEPFILTERS ( Fact_AnomaliSkor[Skor] = s )",
              "    )"
            ],
            "displayFolder": "5 Erken Uyari"
          },
          {
            "name": "Ortalama Anomali Skoru",
            "expression": [
              "AVERAGE ( Fact_AnomaliSkor[Skor] )"
            ],
            "displayFolder": "5 Erken Uyari",
            "formatString": "0.0"
          },
          {
            "name": "Yuksek Anomali Musteri",
            "expression": [
              "CALCULATE (",
              "    DISTINCTCOUNT ( Fact_AnomaliSkor[VKN] ),",
              "    KEEPFILTERS ( Fact_AnomaliSkor[SonSorguMu] = 1 ),",
              "    KEEPFILTERS ( Fact_AnomaliSkor[Skor] >= 70 )",
              ") + 0"
            ],
            "displayFolder": "5 Erken Uyari",
            "formatString": "#,0"
          },
          {
            "name": "Skor70 Sonraki Gecikme %",
            "expression": [
              "CALCULATE (",
              "    AVERAGE ( Fact_AnomaliSkor[SonrakiGecikmeVar] ),",
              "    KEEPFILTERS ( Fact_AnomaliSkor[Skor] >= 70 ),",
              "    KEEPFILTERS ( Fact_AnomaliSkor[GecikmeVar] = 0 )",
              ")"
            ],
            "displayFolder": "5 Erken Uyari",
            "formatString": "0.0%"
          },
          {
            "name": "Diger Sonraki Gecikme %",
            "expression": [
              "CALCULATE (",
              "    AVERAGE ( Fact_AnomaliSkor[SonrakiGecikmeVar] ),",
              "    KEEPFILTERS ( Fact_AnomaliSkor[Skor] < 70 ),",
              "    KEEPFILTERS ( Fact_AnomaliSkor[GecikmeVar] = 0 )",
              ")"
            ],
            "displayFolder": "5 Erken Uyari",
            "formatString": "0.0%"
          }
        ]
      },
