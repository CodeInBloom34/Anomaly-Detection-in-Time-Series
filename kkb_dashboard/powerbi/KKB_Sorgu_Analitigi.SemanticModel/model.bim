{
  "name": "KKB_Sorgu_Analitigi",
  "compatibilityLevel": 1550,
  "model": {
    "culture": "tr-TR",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "tr-TR",
    "tables": [
      {
        "name": "Dim_Tarih",
        "columns": [
          {
            "name": "Tarih",
            "dataType": "dateTime",
            "sourceColumn": "Tarih",
            "summarizeBy": "none",
            "formatString": "dd.mm.yyyy",
            "isKey": true
          },
          {
            "name": "Yil",
            "dataType": "int64",
            "sourceColumn": "Yil",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "Ay",
            "dataType": "int64",
            "sourceColumn": "Ay",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "AyAdi",
            "dataType": "string",
            "sourceColumn": "AyAdi",
            "summarizeBy": "none"
          },
          {
            "name": "Ceyrek",
            "dataType": "string",
            "sourceColumn": "Ceyrek",
            "summarizeBy": "none"
          },
          {
            "name": "HaftaninGunu",
            "dataType": "int64",
            "sourceColumn": "HaftaninGunu",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "AyinHaftasi",
            "dataType": "int64",
            "sourceColumn": "AyinHaftasi",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "ResmiTatilMi",
            "dataType": "int64",
            "sourceColumn": "ResmiTatilMi",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "IsGunu",
            "dataType": "int64",
            "sourceColumn": "IsGunu",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "AySonuMu",
            "dataType": "int64",
            "sourceColumn": "AySonuMu",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "BayramOncesiMi",
            "dataType": "int64",
            "sourceColumn": "BayramOncesiMi",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "type": "calculated",
            "name": "Ay Donemi",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "IF ( Dim_Tarih[AySonuMu] = 1, \"Ay sonu (son 5 gun)\", \"Ay ici\" )"
            ],
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Gun Adi",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH ( Dim_Tarih[HaftaninGunu], 1, \"1 Pzt\", 2, \"2 Sal\", 3, \"3 Car\", 4, \"4 Per\", 5, \"5 Cum\", 6, \"6 Cmt\", \"7 Paz\" )"
            ],
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Yil Ceyrek",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "Dim_Tarih[Yil] & \"-\" & Dim_Tarih[Ceyrek]"
            ],
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim_Tarih",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Kaynak = Csv.Document(File.Contents(VeriKlasoru & \"\\Dim_Tarih.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Basliklar = Table.PromoteHeaders(Kaynak, [PromoteAllScalars = true]),",
                "    Bosluklar = Table.TransformColumns(Basliklar, {}, each if _ = \"\" then null else _),",
                "    Tipler = Table.TransformColumnTypes(Bosluklar, {{\"Tarih\", type date}, {\"Yil\", Int64.Type}, {\"Ay\", Int64.Type}, {\"AyAdi\", type text}, {\"Ceyrek\", type text}, {\"HaftaninGunu\", Int64.Type}, {\"AyinHaftasi\", Int64.Type}, {\"ResmiTatilMi\", Int64.Type}, {\"IsGunu\", Int64.Type}, {\"AySonuMu\", Int64.Type}, {\"BayramOncesiMi\", Int64.Type}}, \"en-US\")",
                "in",
                "    Tipler"
              ]
            }
          }
        ],
        "dataCategory": "Time"
      },
