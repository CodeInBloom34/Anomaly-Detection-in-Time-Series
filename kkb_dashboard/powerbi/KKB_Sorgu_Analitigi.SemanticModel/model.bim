            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "GayrinakdiRisk",
            "dataType": "double",
            "sourceColumn": "GayrinakdiRisk",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "BankaSayisi",
