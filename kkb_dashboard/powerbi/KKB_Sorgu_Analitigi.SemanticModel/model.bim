          },
          {
            "name": "PortfoyYoneticisi",
            "dataType": "string",
            "sourceColumn": "PortfoyYoneticisi",
            "summarizeBy": "none"
          },
          {
            "name": "_Senaryo",
            "dataType": "string",
            "sourceColumn": "_Senaryo",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "NACEAciklama",
            "dataType": "string",
            "sourceColumn": "NACEAciklama",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Dim_Musteri",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Kaynak = Csv.Document(File.Contents(VeriKlasoru & \"\\Dim_Musteri.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Basliklar = Table.PromoteHeaders(Kaynak, [PromoteAllScalars = true]),",
                "    Bosluklar = Table.TransformColumns(Basliklar, {}, each if _ = \"\" then null else _),",
                "    Tipler = Table.TransformColumnTypes(Bosluklar, {{\"VKN\", type text}, {\"Unvan\", type text}, {\"Segment\", type text}, {\"NACE\", type text}, {\"Il\", type text}, {\"Bolge\", type text}, {\"SubeKod\", type text}, {\"GrupKod\", type text}, {\"MusteriSinceTarihi\", type date}, {\"PortfoyYoneticisi\", type text}, {\"_Senaryo\", type text}, {\"NACEAciklama\", type text}}, \"en-US\")",
                "in",
                "    Tipler"
              ]
            }
          }
        ]
      },
