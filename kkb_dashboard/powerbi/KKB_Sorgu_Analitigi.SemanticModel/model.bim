              "expression": [
                "let",
                "    Kaynak = Csv.Document(File.Contents(VeriKlasoru & \"\\Dim_NotBandi.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Basliklar = Table.PromoteHeaders(Kaynak, [PromoteAllScalars = true]),",
                "    Bosluklar = Table.TransformColumns(Basliklar, {}, each if _ = \"\" then null else _),",
                "    Tipler = Table.TransformColumnTypes(Bosluklar, {{\"Bant\", type text}, {\"MinNot\", Int64.Type}, {\"MaxNot\", Int64.Type}, {\"Renk\", type text}}, \"en-US\")",
                "in",
                "    Tipler"
              ]
            }
          }
        ]
      },
      {
