                "let",
                "    Kaynak = Csv.Document(File.Contents(VeriKlasoru & \"\\Dim_Sube.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Basliklar = Table.PromoteHeaders(Kaynak, [PromoteAllScalars = true]),",
                "    Bosluklar = Table.TransformColumns(Basliklar, {}, each if _ = \"\" then null else _),",
                "    Tipler = Table.TransformColumnTypes(Bosluklar, {{\"SubeKod\", type text}, {\"SubeAdi\", type text}, {\"Il\", type text}, {\"Bolge\", type text}, {\"SubeTipi\", type text}}, \"en-US\")",
                "in",
                "    Tipler"
              ]
            }
          }
        ]
      },
