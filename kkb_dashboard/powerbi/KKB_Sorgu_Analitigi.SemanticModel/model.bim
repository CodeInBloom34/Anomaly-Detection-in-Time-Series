            "sourceColumn": "CekKarsiliksizAdet",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "BizimLimit",
            "dataType": "double",
            "sourceColumn": "BizimLimit",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "BizimRisk",
            "dataType": "double",
            "sourceColumn": "BizimRisk",
            "summarizeBy": "none",
            "formatString": "#,0.##"
          },
          {
            "name": "SorguID",
            "dataType": "int64",
            "sourceColumn": "SorguID",
            "summarizeBy": "none",
            "formatString": "0"
          },
          {
            "name": "VKN",
